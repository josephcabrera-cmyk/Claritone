# ---- STM32CubeIDE build output ----
Debug/
Release/
*.elf
*.bin
*.hex
*.map
*.list
*.o
*.d
*.su
*.cyclo

# Workspace metadata
.metadata/

# ---- Files STM32CubeMX regenerates from each .ioc ----
# Only application sources and .ioc files are tracked; see firmware/README.md.
# Generated project files also record machine-specific paths.
firmware/**/Drivers/
firmware/**/Middlewares/
firmware/**/Startup/
firmware/**/.settings/
firmware/**/.project
firmware/**/.cproject
firmware/**/.mxproject
firmware/**/*.ld
firmware/**/*.launch

# ---- ST VL53L7CX ULD driver (STSW-IMG036) ----
# Not redistributable; see the License section of the README.
VL53L7CX_ULD/

# ---- Desktop spatial audio prototype ----
prototypes/spatial-audio/spatial_tone
prototypes/spatial-audio/spatial_tone.exe

# ---- Autodesk EAGLE / Fusion Electronics backups and locks ----
*.s#?
*.b#?
*.l#?
*.lck

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
